{
  "name": "git-lines",
  "displayName": "Git Lines",
  "description": "Read-only Git graph with stable lanes, reflog history, and evidence-based operation overlays.",
  "version": "0.1.0",
  "publisher": "lye-0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lye-0/git-lines.git"
  },
  "homepage": "https://github.com/Lye-0/git-lines#readme",
  "bugs": {
    "url": "https://github.com/Lye-0/git-lines/issues"
  },
  "icon": "resources/icon-v1.png",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["SCM Providers", "Visualization"],
  "keywords": ["git", "graph", "history", "reflog", "rebase", "visualization"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Git Lines reads repository files using the Git CLI in a local or remote workspace."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Trust the workspace to let Git Lines read the repository using Git."
    }
  },
  "activationEvents": [
    "onCommand:branchGraph.open",
    "onCommand:branchGraph.refresh",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "branchGraph.openSidebar", "title": "Git Lines: Open in Sidebar" },
      {
        "command": "branchGraph.open",
        "title": "Git Lines: Open"
      },
      {
        "command": "branchGraph.openEditor",
        "title": "Git Lines: Open in Editor"
      },
      {
        "command": "branchGraph.openPanel",
        "title": "Git Lines: Open in Panel"
      },
      {
        "command": "branchGraph.refresh",
        "title": "Git Lines: Refresh"
      }
    ],
    "configuration": {
      "title": "Git Lines",
      "properties": {
        "branchGraph.primaryBranch": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional branch name to use as the primary visual lane."
        },
        "branchGraph.initialCommitCount": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Number of commits initially shown."
        },
        "branchGraph.loadMoreCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Number of commits loaded when the graph is extended."
        },
        "branchGraph.showReflog": {
          "type": "boolean",
          "default": true,
          "description": "Show previous-route commits and ref movement events when Git still retains them."
        },
        "branchGraph.density": {
          "type": "string",
          "enum": ["comfortable", "compact"],
          "default": "comfortable",
          "description": "Default graph row density."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [{ "id": "git-lines-sidebar", "title": "Git Lines", "icon": "resources/git-lines.svg" }],
      "panel": [
        {
          "id": "git-lines",
          "title": "Git Lines",
          "icon": "resources/git-lines.svg"
        }
      ]
    },
    "views": {
      "git-lines-sidebar": [{ "type": "webview", "id": "branchGraph.sidebarView", "name": "Git Lines" }],
      "git-lines": [
        {
          "type": "webview",
          "id": "branchGraph.panelView",
          "name": "Git Lines"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm build:webview && pnpm build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "build:webview": "vite build --config webview/vite.config.ts",
    "dev:webview": "vite --config webview/vite.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies --githubBranch main",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
